<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:paddingBottom="80dp"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Header Gradient Area -->
        <View
            android:id="@+id/viewHeaderBackground"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/gradient_primary"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- User Profile Info Row -->
        <LinearLayout
            android:id="@+id/layoutUserInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvWelcomeBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back,"
                        android:textColor="#E0E7FF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inspector"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivSidebarArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Open Sidebar"
                    app:tint="#E0E7FF" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_notification"
                android:padding="10dp"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#20FFFFFF"
                app:tint="@color/white"
                android:contentDescription="Notifications" />
        </LinearLayout>

        <!-- Stats Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSafetyScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/layoutUserInfo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overall Safety Score"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSafetyScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A+"
                        android:textColor="@color/primary_purple"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvComplianceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excellent Compliance"
                        android:textColor="@color/success_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/gray_100" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvCompliancePercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="@color/primary_orange"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compliance"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick Actions Grid -->
        <TextView
            android:id="@+id/tvQuickActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSafetyScore" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvQuickActions">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardInspections"
                android:layout_width="0dp" android:layout_height="100dp"
                android:layout_columnWeight="1" android:layout_margin="8dp"
                app:cardCornerRadius="16dp" app:cardElevation="1dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_inspections" app:tint="@color/primary_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Inspections" android:textColor="@color/text_primary"
                        android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardHistory"
                android:layout_width="0dp" android:layout_height="100dp"
                android:layout_columnWeight="1" android:layout_margin="8dp"
                app:cardCornerRadius="16dp" app:cardElevation="1dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_history" app:tint="@color/primary_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="History" android:textColor="@color/text_primary"
                        android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTeam"
                android:layout_width="0dp" android:layout_height="100dp"
                android:layout_columnWeight="1" android:layout_margin="8dp"
                app:cardCornerRadius="16dp" app:cardElevation="1dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_team" app:tint="@color/primary_purple" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Team" android:textColor="@color/text_primary"
                        android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTraining"
                android:layout_width="0dp" android:layout_height="100dp"
                android:layout_columnWeight="1" android:layout_margin="8dp"
                app:cardCornerRadius="16dp" app:cardElevation="1dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_training" app:tint="@color/primary_orange" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Training" android:textColor="@color/text_primary"
                        android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCompliance"
                android:layout_width="0dp" android:layout_height="100dp"
                android:layout_columnWeight="1" android:layout_margin="8dp"
                app:cardCornerRadius="16dp" app:cardElevation="1dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_compliance" app:tint="@color/primary_orange" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Alerts" android:textColor="@color/text_primary"
                        android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSettings"
                android:layout_width="0dp" android:layout_height="100dp"
                android:layout_columnWeight="1" android:layout_margin="8dp"
                app:cardCornerRadius="16dp" app:cardElevation="1dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_settings" app:tint="@color/text_muted" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Settings" android:textColor="@color/text_primary"
                        android:textSize="12sp" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
